BACKEND_ENVIRONMENT=dev
LLM_PROVIDER=claude
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=your_api_key_here

# 数据库（本地开发使用 SQLite，会自动在项目根目录创建 diy_dictionary.db）
# DATABASE_URL=sqlite:///./diy_dictionary.db

# 生产环境 PostgreSQL（示例）
# DATABASE_URL=postgresql://user:password@localhost/diy_dictionary

# CORS 允许的源
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
